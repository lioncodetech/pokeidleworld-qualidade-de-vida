{
  "manifest_version": 3,
  "name": "Poke Idle World - qualidade de vida",
  "version": "1.6.0",
  "description": "Captura, hunts por tipo, times, level cap e ciclo seguro com depósito, venda e reposição. Alt+Q abre o menu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "nucleo.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "sem-grafico.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "pausa.js",
        "agenda.js",
        "captura.js",
        "ciclo.js",
        "loja.js",
        "tipos-hunts.js",
        "cacadas.js",
        "times.js",
        "escada.js",
        "arrumar.js",
        "recarregar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
