{
  "manifest_version": 3,
  "name": "Poke Idle World - qualidade de vida",
  "version": "1.1.1",
  "description": "Captura sozinho, ciclo da loja, cacadas e times guardados, troca de cacada por nivel e para o grafico. Alt+Q abre o menu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "nucleo.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "sem-grafico.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "pausa.js",
        "agenda.js",
        "captura.js",
        "loja.js",
        "ciclo.js",
        "cacadas.js",
        "times.js",
        "escada.js",
        "arrumar.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
