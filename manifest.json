{
  "manifest_version": 3,
  "name": "Poke Idle World - qualidade de vida",
  "version": "1.0.0",
  "description": "Lanca a pokebola sozinho, faz o ciclo da loja, guarda cacadas e times e troca de cacada por nivel. Alt+Q abre o menu.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "nucleo.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://poke.idleworld.online/*"
      ],
      "js": [
        "pausa.js",
        "agenda.js",
        "captura.js",
        "loja.js",
        "ciclo.js",
        "cacadas.js",
        "times.js",
        "escada.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
